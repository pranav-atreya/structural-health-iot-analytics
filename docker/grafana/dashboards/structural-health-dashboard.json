      "title": "1. Sensor Connectivity, Hardware Diagnostics & Latest Telemetry",
      "type": "row"
    },
    {
      "datasource": { "type": "influxdb", "uid": "influxdb_structural_health" },
      "description": "Latest telemetry sequence number, ESP32 uptime, and IMU WHO_AM_I register identity (0x68 = 104 dec for MPU-6050, 0x70 = 112 dec for MPU-6500).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "noValue": "Awaiting Telemetry",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "uptime_ms" },
            "properties": [{ "id": "unit", "value": "ms" }, { "id": "displayName", "value": "ESP32 Uptime" }]
          },
          {
            "matcher": { "id": "byName", "options": "seq" },
            "properties": [{ "id": "displayName", "value": "Packet Seq #" }]
          },
          {
            "matcher": { "id": "byName", "options": "imu_who_am_i" },
            "properties": [
              { "id": "displayName", "value": "IMU WHO_AM_I" },
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "104": { "color": "green", "index": 0, "text": "0x68 (MPU-6050)" },
                      "112": { "color": "green", "index": 1, "text": "0x70 (MPU-6500)" }
                    },
                    "type": "value"
                  }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "hx711_calibrated_int" },
            "properties": [
              { "id": "displayName", "value": "Load Cell Calibration" },
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "0": { "color": "orange", "index": 0, "text": "UNCALIBRATED (Counts Only)" },
                      "1": { "color": "green", "index": 1, "text": "CALIBRATED (Grams Active)" }
                    },
                    "type": "value"
                  }
                ]
              }
            ]
          }
        ]
      },
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 1 },
      "id": 10,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "influxdb_structural_health" },
          "query": "from(bucket: \"structural_health\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"bridge_telemetry\")\n  |> filter(fn: (r) => r[\"_field\"] == \"seq\" or r[\"_field\"] == \"uptime_ms\" or r[\"_field\"] == \"imu_who_am_i\" or r[\"_field\"] == \"hx711_calibrated_int\")\n  |> last()\n  |> keep(columns: [\"_field\", \"_value\"])",
          "refId": "A"
        }
      ],
      "title": "10. Sensor Connectivity & Hardware Identity Status",
      "type": "stat"
    },
    {
