# ============================================================================
# STRUCTURAL HEALTH IoT ANALYTICS — ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================
# Copy this file to `.env` in the repository root before starting Docker:
#   Copy-Item .env.example .env
# `.env` is ignored by Git so local credentials and tokens are never committed.
# ============================================================================

# --- 1. Eclipse Mosquitto MQTT Broker ---
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=bridge_iot
MQTT_PASSWORD=bridge_iot_pass
MQTT_ALLOW_ANONYMOUS=false
MQTT_TOPIC=structural-health/+/telemetry
DEFAULT_DEVICE_ID=esp32-bridge-01

# --- 2. InfluxDB 2.x Time-Series Database ---
INFLUXDB_URL=http://localhost:8086
INFLUXDB_PORT=8086
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=bridge_influx_admin_2026
INFLUXDB_ORG=pes-iot
INFLUXDB_BUCKET=structural_health
INFLUXDB_RETENTION=30d
INFLUXDB_TOKEN=structural-health-iot-local-dev-token-2026

# --- 3. Grafana Dashboard ---
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=bridge_grafana_admin

# --- 4. Local Serial Recording / Calibration CLI Defaults ---
SERIAL_PORT=COM3
SERIAL_BAUD=115200
